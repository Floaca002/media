# --- Vault backend ---
VAULT_JWT_SECRET=change-me-to-a-long-random-string
VAULT_JWT_EXPIRE_MINUTES=1440
VAULT_DATABASE_URL=sqlite:///./vault.db
VAULT_CORS_ORIGINS=http://localhost:3000

# --- TMDB ---
TMDB_API_READ_TOKEN=paste-your-tmdb-v4-read-access-token-here
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# --- qBittorrent ---
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change-me
QBITTORRENT_CATEGORY_MOVIES=vault-movies
QBITTORRENT_CATEGORY_TV=vault-tv
# Must match whatever category you set in Radarr's/Sonarr's own
# download-client config — the Downloads tab watches these too.
QBITTORRENT_CATEGORY_RADARR=radarr
QBITTORRENT_CATEGORY_SONARR=sonarr

# --- Jellyfin ---
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=paste-an-admin-api-key-from-jellyfin-dashboard
JELLYFIN_CLIENT_NAME=Vault
JELLYFIN_DEVICE_NAME=vault-backend
JELLYFIN_DEVICE_ID=vault-backend-001
JELLYFIN_VERSION=1.0.0

# --- Radarr / Sonarr (automatic release search + grab) ---
# API keys are generated by each app itself on first run — open its
# dashboard once (temporarily expose its port), copy the key from
# Settings > General, then paste it here. Leave blank to fall back to
# pasting magnet links manually instead.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# --- Media paths (must be the same filesystem for hardlinks to work) ---
# DOWNLOADS_SAVE_PATH must match the qbittorrent service's media-downloads
# mount point in docker-compose.yml exactly — this is where we explicitly
# tell qBittorrent to save everything, overriding its own internal default.
DOWNLOADS_SAVE_PATH=/data/downloads
MEDIA_MOVIES_PATH=/data/media/movies
MEDIA_TV_PATH=/data/media/tv
